---
import { getCollection } from 'astro:content';
import { socialLinks, sortByServiceOrder } from '../../config/site';
import CallBar from './CallBar.astro';
import GoogleReviews from '../widgets/GoogleReviews.astro';
import VetstoriaButton from '../widgets/VetstoriaButton.astro';
import UserWay from '../widgets/UserWay.astro';
import SocialIcon from '../icons/SocialIcon.astro';
import { Image } from 'astro:assets';
import footerBadge from '~/assets/697795a18df67465edd361bb_1680028744419.png';

// Corrected 2026-08-11 against the project owner's own side-by-side diff of
// the live footer: an earlier pass had mis-extracted the PHONE / ADDRESS /
// EMAIL / HOURS boxes as part of the visible footer. They actually live
// inside `.old-footer-new-template`, a hidden (`.hide`) dead block that is
// NOT reproduced anywhere in this file (verified: `.old-footer-new-template`
// never appears below) — those four boxes never existed on the real footer
// and are gone for good, not merged elsewhere.
//
// The real visible footer is `.footer-grid-desktop` with exactly 4
// `.footer-box-2` children (About Us, Services, Resources, and an unheaded
// badge/social box) inside `.container-2.container-footer` — verified
// directly against tools/snapshots/home.html. It uses the `-2` class
// variants throughout (`footer-heading-2`, `footer-link-2`, `footer-box-2`);
// the non-`-2` names exist in home.css too, but only inside the dead block
// above, styled for a light background — not used here.
const services = sortByServiceOrder(await getCollection('services'));

// Live order for this one box is Instagram before Facebook, opposite of the
// header's social row and the socialLinks array order — confirmed in both
// the desktop (`.social-icon-link-3`) and mobile (`.social-icon-link-4`)
// markup in tools/snapshots/home.html. Reversed once here for both boxes
// rather than reordering the shared `socialLinks` array, which would also
// flip the header's (correctly Facebook-first) row.
const footerSocialLinks = [...socialLinks].reverse();
---
<footer class="footer">
  <div class="container-2 container-footer">
    <div class="footer-grid-desktop">
      <div class="footer-box-2">
        <div class="footer-heading-2">About Us</div>
        <div class="footer-links-wrapper">
          <a href="/meet-the-team" class="footer-link-2">Meet the Team</a>
          <a href="/conferences" class="footer-link-2">Conferences</a>
          {/* Live element is `<a href="#" class="footer-link-2 rm-trigger">`, driven by
              Webflow's own (unshipped) rm-trigger JS. Rendered as a real button wired to
              our own data-modal-open mechanism instead — the same convention already used
              for this exact "How'd we do?" action in Nav.astro and CallBar.astro — rather
              than shipping a third, inconsistent `href="#"` pattern in this one spot. */}
          <button type="button" class="footer-link-2 rm-trigger" data-modal-open="howd-we-do">How'd we do?</button>
          {/* Photo Gallery intentionally omitted: /photo-gallery is draft:true in Webflow,
              and the live link itself carries `.footer-link-2.hide` (display:none) — the
              live site already hides it, matching this omission. */}
        </div>
      </div>

      <div class="footer-box-2">
        <div class="footer-heading-2">Services</div>
        <div class="footer-links-wrapper">
          {services.map((s) => (
            <a href={`/services/${s.data.slug}`} class="footer-link-2"><div>{s.data.name}</div></a>
          ))}
        </div>
      </div>

      <div class="footer-box-2">
        <div class="footer-heading-2">Resources</div>
        <div class="footer-links-wrapper">
          <a href="/general-information-request" class="footer-link-2">Contact Us</a>
          <a href="/appointment-request" class="footer-link-2">Request an Appointment</a>
          <a href="/blog" class="footer-link-2">Our Blog</a>
        </div>
      </div>

      <div class="footer-box-2">
        <Image src={footerBadge} alt="" class="image-8" loading="lazy" />
        <div class="footer-social-wrapper-2">
          <div class="social-collection-list social-collection-list-footer">
            {footerSocialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="me nofollow noopener" class="social-icon-link-3" aria-label={s.label}>
                <SocialIcon platform={s.icon} class="social-icon footer-social-icon" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/* Mobile block replicates the live accordion (tools/snapshots/home.html,
        search "footer-grid-mobile") exactly: About Us / Services / Resources
        sections plus a trailing social-icon row. PHONE, ADDRESS, EMAIL, and
        HOURS were never part of this block either — the live mobile
        accordion has no such content, desktop or mobile. Photo Gallery is
        omitted here too, same reasoning as above. */}
    <div class="footer-grid-mobile">
      <div class="accordion-trigger footer-accordion">
        <button type="button" class="accordion-header-footer" aria-expanded="false" aria-controls="mobile-footer-about">
          <span class="mobile-footer-heading-2">About Us</span>
          <span class="accordion-icon" aria-hidden="true"></span>
        </button>
        <div class="accordion-content-footer" id="mobile-footer-about">
          <div class="footer-links-wrapper">
            <a class="footer-link-2" href="/meet-the-team">Meet the Team</a>
            <a class="footer-link-2" href="/conferences">Conferences</a>
            <button type="button" class="footer-link-2" data-modal-open="howd-we-do">How'd we do?</button>
          </div>
        </div>
      </div>

      <div class="accordion-trigger footer-accordion">
        <button type="button" class="accordion-header-footer" aria-expanded="false" aria-controls="mobile-footer-services">
          <span class="mobile-footer-heading-2">Services</span>
          <span class="accordion-icon" aria-hidden="true"></span>
        </button>
        <div class="accordion-content-footer" id="mobile-footer-services">
          <div class="footer-links-wrapper">
            {services.map((s) => (
              <a class="footer-link-2" href={`/services/${s.data.slug}`}>{s.data.name}</a>
            ))}
          </div>
        </div>
      </div>

      <div class="accordion-trigger footer-accordion bottom-accordion">
        <button type="button" class="accordion-header-footer" aria-expanded="false" aria-controls="mobile-footer-resources">
          <span class="mobile-footer-heading-2">Resources</span>
          <span class="accordion-icon" aria-hidden="true"></span>
        </button>
        <div class="accordion-content-footer" id="mobile-footer-resources">
          <div class="footer-links-wrapper">
            <a class="footer-link-2" href="/general-information-request">Contact Us</a>
            <a class="footer-link-2" href="/appointment-request">Request an Appointment</a>
            <a class="footer-link-2" href="/blog">Our Blog</a>
          </div>
        </div>
      </div>

      <div class="footer-box-2">
        <div class="footer-social-wrapper-2">
          {/* Live mobile row is also Instagram-then-Facebook (`.social-icon-link-4`),
              same as the desktop box above — reusing footerSocialLinks rather than
              socialLinks here too. Icons were empty `.ci-font` placeholders here as
              well; same real-SVG fix applied. */}
          <div class="social-collection-list social-collection-list-footer">
            {footerSocialLinks.map((s) => (
              <a class="social-icon-link-4" href={s.href} target="_blank" rel="me nofollow noopener" aria-label={s.label}>
                <SocialIcon platform={s.icon} class="social-icon footer-social-icon" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom-2">
      <div class="footer_practice">
        <div>&copy; The Veterinary Internal Medicine Group (VIMG)</div>
      </div>
      <div class="footer-signature-wrapper-2">
        Made with love <span aria-hidden="true">🐾</span> <a href="http://veterinarymarketing.com/" target="_blank" rel="noopener" class="link-marketing-site-2">Veterinary Marketing</a>
      </div>
    </div>
  </div>

  <CallBar />
  <GoogleReviews />
  <VetstoriaButton />
  <UserWay />
</footer>

<script>
  import { initFooterAccordion } from '../../scripts/footer-accordion';
  initFooterAccordion();
</script>
